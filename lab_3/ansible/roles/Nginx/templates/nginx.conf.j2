user www-data;
worker_processes auto;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    proxy_cache_path {{ nginx_cache_path }} levels={{ nginx_cache_levels }} keys_zone={{ nginx_cache_keys_zone }} max_size={{ nginx_max_cache_size }} inactive={{ nginx_inactive_cache_time }} use_temp_path=off;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for" '
                      '$upstream_cache_status';

    upstream backend_servers {
    	{% for host in groups[nginx_back_host_group] %}
    	server {{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['port'] | default(nginx_default_backend_servers_port) }};
    	{% endfor %}
    }

    server {
        listen {{ nginx_listen_port }};

        location / {
            proxy_pass http://backend_servers;
	    proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            access_log {{ nginx_proxy_access_log_path }} main;
        }

	location {{ nginx_static_data_path }} {
            proxy_pass http://backend_servers;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

	    proxy_cache STATIC;
            proxy_cache_valid 200 {{ nginx_cache_live_time }};
            proxy_cache_key $uri$is_args$args;
	    
            add_header X-Cache-Status $upstream_cache_status;
            expires off;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";

            access_log {{ nginx_cache_access_log_path }} main;
        }
    }
}
